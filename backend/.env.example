# MongoDB (required — shared by memory + auth)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MEMORY_DATABASE=agentic_ai_memory
MEMORY_COLLECTION=memories_history

# Groq / Gemini (existing)
GROQ_API_KEY=your_groq_api_key_here
# Topic 42b — provider selection. Default groq. openai is reserved (no adapter yet).
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
# Topics 43–44 — bounded parallel tool execution (read-only tools only)
AGENT_MAX_PARALLEL_TOOLS=3
AGENT_TOOL_POOL_WORKERS=4
AGENT_GLOBAL_TOOL_CONCURRENCY=8
# Topics 45–47 — tool timeouts / retries / fallbacks (NOT Topic 38 LLM retries)
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TOOL_TIMEOUT_MAX_SECONDS=120
AGENT_TOOL_MAX_RETRIES=2
AGENT_TOOL_RETRY_BUDGET_SECONDS=45
AGENT_TOOL_RETRY_BASE_SECONDS=0.25
AGENT_TOOL_RETRY_MAX_BACKOFF_SECONDS=8
AGENT_TOOL_FALLBACK_MAX_DEPTH=1
AGENT_TOOL_MAX_OUTSTANDING_TIMED_OUT=16
# Topics 48–53 — agent security (HITL off by default to preserve Topics 1–47)
AGENT_HITL_ENABLED=false
AGENT_TOOL_PERMISSIONS_ENFORCE=true
AGENT_SECURITY_POLICY_VERSION=1
AGENT_APPROVAL_TTL_SECONDS=900
AGENT_APPROVAL_MAX_TTL_SECONDS=86400
AGENT_APPROVALS_COLLECTION=agent_approvals
AGENT_TOOL_PERMISSIONS_COLLECTION=agent_tool_permissions
AGENT_SECURITY_AUDIT_COLLECTION=agent_security_audit
AGENT_TOOL_PERMISSION_CACHE_TTL=2
# Comma-separated user ids allowed to grant/revoke tool permissions (not self-serve)
# AGENT_PERMISSION_ADMIN_USER_IDS=
# Optional extra reviewers beyond the requesting user
# AGENT_APPROVAL_REVIEWER_USER_IDS=
AGENT_SANDBOX_MAX_OUTPUT_BYTES=524288
AGENT_SANDBOX_MAX_FILE_BYTES=2097152
# Optional override for filesystem confinement root (default: backend PROJECT_ROOT)
# AGENT_SANDBOX_ROOT=
# Future OpenAI adapter (do not set unless implementing Topic OpenAI provider):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
GEMINI_API_KEY=your_gemini_api_key_here
# The current embedding_service.py reads GOOGLE_API_KEY (existing deployments
# may set this name). Keep the provider key in the local secret file only.
GOOGLE_API_KEY=your_google_api_key_here

# ---------------------------------------------------------------------------
# RAG application settings (defaults match app.services.rag_config.RagSettings)
# Verified against Atlas rag_chunks.vector_index; do not change embedding
# dimension/similarity without a separately reviewed index migration.
# ---------------------------------------------------------------------------
RAG_CHUNKS_COLLECTION=rag_chunks
RAG_VECTOR_INDEX=vector_index
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
# Must match the Atlas vectorSearch field similarity (cosine).
RAG_VECTOR_SIMILARITY=cosine
# Max upload body size in bytes (5 MiB).
RAG_MAX_UPLOAD_BYTES=5242880
# Redis-backed per-user upload rate limit (count per window).
RAG_UPLOAD_RATE_LIMIT_COUNT=10
RAG_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=160
RAG_MAX_CHUNKS_PER_DOCUMENT=256
# Chunking strategy: char (default fallback) or markdown (structure-aware).
RAG_CHUNKING_STRATEGY=char
# Batch 1 format flags (TXT/Markdown always enabled).
RAG_ENABLE_PDF=true
RAG_ENABLE_DOCX=true
RAG_ENABLE_HTML=true
RAG_ENABLE_CSV=true
# Redis vector-only embedding cache (never caches document text).
RAG_EMBEDDING_CACHE=true
RAG_EMBEDDING_CACHE_TTL_SECONDS=604800
# Logical embedding version label stored on chunks (does not change 768-d index).
RAG_EMBEDDING_VERSION=rag-embed-v1
RAG_TOP_K=6
RAG_CANDIDATE_LIMIT=80
# Atlas $vectorSearch numCandidates (0 = auto min(candidate_limit*10, 800)).
RAG_NUM_CANDIDATES=0
# Lexical scan and readable-document scan bound.
RAG_LEXICAL_SCAN_LIMIT=2000
# Character budget for packed JSON evidence + fixed evidence-message wrapper.
RAG_CONTEXT_BUDGET_CHARS=12000
# Token budget for retrieve() evidence packing (includes wrapper overhead).
RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_CONTEXT_MAX_CHUNKS=8
RAG_MIN_VECTOR_SCORE=0.25
# Lexical backend: overlap (default fallback) or bm25 (requires Atlas Search index).
RAG_LEXICAL_BACKEND=overlap
# Atlas Search index name for BM25 (do not modify vector_index). Manual setup required.
RAG_SEARCH_INDEX=rag_text_index
RAG_HYBRID_VECTOR_WEIGHT=1.0
RAG_HYBRID_LEXICAL_WEIGHT=1.0
RAG_RRF_K=60
# Reranker: none | heuristic | cross_encoder (cross_encoder optional; needs sentence-transformers).
RAG_RERANKER=none
# Legacy boolean; if true and RAG_RERANKER=none, heuristic is used.
RAG_ENABLE_RERANKING=false
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_TOP_N=20
RAG_RERANK_TIMEOUT_SECONDS=8
# Split explicit multi-part questions into additional retrieval clauses.
RAG_ENABLE_QUERY_DECOMPOSITION=true
# Optional conservative pronoun/ellipsis rewrite from prior user turns (off).
RAG_ENABLE_CONVERSATION_REWRITE=false
# Optional Groq multi-query expansion (off by default).
RAG_ENABLE_MULTI_QUERY=false
RAG_MAX_REWRITTEN_QUERIES=3
# Optional HyDE (hypothetical passage for retrieval only; never cited/stored).
RAG_ENABLE_HYDE=false
# Optional Groq evidence compression (off by default; preserves source_ids).
RAG_ENABLE_SEMANTIC_COMPRESSION=false
RAG_COMPRESSION_MAX_OUTPUT_TOKENS=512
# Near-duplicate Jaccard threshold for context packing.
RAG_NEAR_DUP_JACCARD=0.92

# ---------------------------------------------------------------------------
# Test-only: live RAG ACL integration (optional; never point at production)
# NOT used by the normal application. Enable only against a disposable Atlas
# database with a READY rag_chunks vector index matching production settings.
# ---------------------------------------------------------------------------
# RAG_ACL_INTEGRATION=1
# RAG_TEST_DATABASE=agentic_ai_memory_rag_acl_test

# ---------------------------------------------------------------------------
# Batch C — gated live integration (default OFF; never auto-run paid APIs)
# See docs/INTEGRATION_TESTING.md. Disposable DB names must include test /
# integration / batch_c. Never set these to production MEMORY_DATABASE.
# ---------------------------------------------------------------------------
# BATCH_C_MONGO_INTEGRATION=1
# MEMORY_TEST_DATABASE=agentic_ai_memory_batch_c_test
# BATCH_C_RAG_INTEGRATION=1
# BATCH_C_REDIS_INTEGRATION=1
# BATCH_C_REDIS_NAMESPACE=agent:batchc:test:
# BATCH_C_LIVE_EMBEDDINGS=1
# BATCH_C_LIVE_GROQ=1
# BATCH_C_LIVE_TAVILY=1
# MEMORY_PERSISTENCE_INTEGRATION=1

# Auth (required for API server)
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# API
API_HOST=0.0.0.0
API_PORT=8787
REQUIRE_AUTH_FOR_CHAT=true

# CORS — comma-separated origins (no wildcards with credentials)
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:8081,http://localhost:19006,http://localhost:5173,http://127.0.0.1:5173

# Rate limits (slowapi format)
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=20/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESET_PASSWORD=10/minute

# Legal policy versions stored on user registration
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01

# Remember-me extends refresh session lifetime
REMEMBER_ME_REFRESH_TTL_DAYS=30

# Password reset (hashed single-use tokens)
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_PUBLIC_BASE_URL=http://localhost:8081/reset-password
# Local QA only — logs full reset URL when SMTP is unset
PASSWORD_RESET_LOG_URL_IN_DEV=false

# Optional SMTP for password-reset emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

# Legacy CLI fallback only when API auth disabled (do not use in production)
# MEMORY_TEST_USER_ID=
