{
  "name": "aichatbot",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "android:apk:debug": "cd android && gradlew.bat assembleDebug",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.18",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.9",
    "tailwindcss": "^3.3.2",
    "typescript": "~5.9.2"
  }
}
