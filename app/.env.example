# Public Expo config (safe to commit). Copy to .env or use defaults.

# Optional override — leave unset to use Metro host + localhost + emulator aliases.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Machine-specific LAN IP (Wi‑Fi dev phone): copy .env.example to .env.local and set:
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:8787
#
# USB: adb reverse tcp:8787 tcp:8787 — then localhost works on device.
